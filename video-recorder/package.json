{
  "name": "video-recorder-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "./run.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "overlay": "electron --no-sandbox electron/main.cjs",
    "prepare:binaries": "node scripts/prepare-binaries.cjs",
    "daemon:build": "node scripts/build-daemon.cjs",
    "daemon:stop": "node scripts/stop-daemon.cjs",
    "daemon:start": "node scripts/start-daemon.cjs",
    "package:dir": "npm run prepare:binaries && npm run build && npm run daemon:build && electron-builder --dir",
    "package:dist": "npm run prepare:binaries && npm run build && npm run daemon:build && electron-builder"
  },
  "description": "Studio-grade screen and camera overlay recorder for Linux",
  "homepage": "https://github.com/harrowmykel/video-recorder-studio",
  "author": "Micheal <micheal@example.com>",
  "desktopName": "video-recorder-studio",
  "build": {
    "appId": "com.studiorecorder.app",
    "productName": "Screen Studio Recorder",
    "executableName": "video-recorder-studio",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "executableArgs": [
        "--no-sandbox"
      ],
      "extraResources": [
        {
          "from": "src-daemon/target/release/recorder-daemon",
          "to": "bin/recorder-daemon"
        },
        {
          "from": "bin/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "resources/remotion-video",
          "to": "resources/remotion-video"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "src-daemon/target/release/recorder-daemon.exe",
          "to": "bin/recorder-daemon.exe"
        },
        {
          "from": "bin/ffmpeg.exe",
          "to": "bin/ffmpeg.exe"
        },
        {
          "from": "resources/remotion-video",
          "to": "resources/remotion-video"
        }
      ]
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/marked": "^5.0.2",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.454.0",
    "marked": "^18.1.1",
    "onnxruntime-web": "^1.30.0",
    "tailwind-merge": "^2.5.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
