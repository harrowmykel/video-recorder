{
  "name": "video-recorder-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "./run.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "overlay": "electron --no-sandbox electron/main.cjs",
    "daemon:build": "export PATH=\"$HOME/.cargo/bin:$PATH\"; cargo build --release --manifest-path src-daemon/Cargo.toml",
    "daemon:stop": "pkill -f recorder-daemon 2>/dev/null || true",
    "daemon:start": "pkill -f recorder-daemon 2>/dev/null || true; if [ -f ./src-daemon/target/release/recorder-daemon ]; then ./src-daemon/target/release/recorder-daemon; else ./src-daemon/target/debug/recorder-daemon; fi",
    "package:dir": "npm run build && npm run daemon:build && electron-builder --dir",
    "package:dist": "npm run build && npm run daemon:build && electron-builder"
  },
  "description": "Studio-grade screen and camera overlay recorder for Linux",
  "author": "Micheal",
  "desktopName": "video-recorder-studio",
  "build": {
    "appId": "com.studiorecorder.app",
    "productName": "Screen Studio Recorder",
    "executableName": "video-recorder-studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src-daemon/target/release/recorder-daemon"
    ],
    "extraResources": [
      {
        "from": "src-daemon/target/release/recorder-daemon",
        "to": "bin/recorder-daemon"
      }
    ],
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Video",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "executableArgs": ["--no-sandbox"]
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.454.0",
    "tailwind-merge": "^2.5.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
